{
    "name": "teamones/think-orm",
    "description": "ThinkORM for webman 2.x（PHP 8.1+）：基于 topthink/think-orm 4.x，整合连接池与分页集成，保留 teamones 的 hint/强制主库扩展",
    "type": "library",
    "keywords": [
        "orm",
        "database",
        "webman",
        "thinkorm"
    ],
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "liu21st",
            "email": "liu21st@gmail.com"
        },
        {
            "name": "Weijer Cheng",
            "email": "weiwei163@foxmail.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-pdo": "*",
        "psr/log": "^2.0 || ^3.0",
        "psr/simple-cache": "^3.0",
        "topthink/think-helper": "^3.1",
        "topthink/think-validate": "^3.0"
    },
    "suggest": {
        "workerman/webman-framework": "启用 Bootstrap 与容器绑定（webman 2.x 环境）",
        "workerman/coroutine": "启用连接池（配合 Webman\\Context）",
        "webman/cache": "查询缓存（support\\Cache）"
    },
    "replace": {
        "topthink/think-orm": "4.0.51"
    },
    "autoload": {
        "psr-4": {
            "think\\": "src",
            "teamones\\thinkorm\\": "integration"
        },
        "files": [
            "stubs/load_stubs.php"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
